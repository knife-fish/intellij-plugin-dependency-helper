<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.knifefish.dependency.helper</id>
    <name>Dependency Helper</name>
    <vendor>Knifefish</vendor>
    <description><![CDATA[
        <p><b>Dependency Helper</b> support Maven and Gradle dependency analysis and package search, Npm package.json version hints.</p>
        <p>It highlights newer releases inline, supports package search, and offers a dependency dashboard with basic conflict and exclusion guidance.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="optional-maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="optional-gradle.xml">com.intellij.gradle</depends>
    <depends optional="true" config-file="optional-npm.xml">com.intellij.modules.javascript</depends>

    <resource-bundle>messages.DependencyHelperBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint
                name="ecosystemSupport"
                interface="org.knifefish.dependency.helper.services.ecosystem.DependencyEcosystemSupport"/>
        <extensionPoint
                name="packageIndexSupport"
                interface="org.knifefish.dependency.helper.services.ecosystem.PackageIndexEcosystemSupport"/>
        <extensionPoint
                name="externalDependencySystem"
                interface="org.knifefish.dependency.helper.services.external.ExternalDependencySystem"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="org.knifefish.dependency.helper.startup.DependencyProjectActivity" />
        <fileEditorProvider implementation="org.knifefish.dependency.helper.editor.DependencyAnalyzerFileEditorProvider"/>
        <notificationGroup id="Dependency Helper Notifications" displayType="NONE"/>
        <lang.documentationProvider
                language="DependencyHelperDocumentation"
                implementationClass="org.knifefish.dependency.helper.documentation.DependencyDocumentationProvider"/>
    </extensions>

    <actions>
        <action id="DependencyHelper.RefreshHints"
                class="org.knifefish.dependency.helper.actions.RefreshDependencyHintsAction"
                text="%Action.Refresh"/>
        <action id="DependencyHelper.UpgradeDependency"
                class="org.knifefish.dependency.helper.actions.UpgradeDependencyAction"
                text="%Action.Upgrade"/>
    </actions>
</idea-plugin>
