<idea-plugin>
    <extensions defaultExtensionNs="org.knifefish.dependency.helper">
        <packageIndexSupport implementation="org.knifefish.dependency.helper.services.ecosystem.GradlePackageIndexSupport"/>
        <externalDependencySystem implementation="org.knifefish.dependency.helper.services.external.GradleExternalSystemAdapter"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="org.knifefish.dependency.helper.services.GradleSupport"
                        serviceImplementation="org.knifefish.dependency.helper.services.DefaultGradleSupport"/>
        <lang.documentationProvider
                language="Groovy"
                order="first"
                implementationClass="org.knifefish.dependency.helper.documentation.DependencyDocumentationProvider"/>
        <lang.documentationProvider
                language="kotlin"
                order="first"
                implementationClass="org.knifefish.dependency.helper.documentation.DependencyDocumentationProvider"/>
    </extensions>
</idea-plugin>
